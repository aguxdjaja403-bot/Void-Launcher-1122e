<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.purplevoid.launcher.LiquidBackground
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFF"
                        android:textSize="46sp" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE"
                        android:format24Hour="EEEE"
                        android:textColor="#F3E8FF"
                        android:textSize="16sp" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="d MMMM"
                        android:format24Hour="d MMMM"
                        android:textColor="#C4B5FD"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/battery"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/glass_pill"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="EEE"
                                android:format24Hour="EEE"
                                android:textAllCaps="true"
                                android:textColor="#F9A8D4"
                                android:textSize="12sp" />

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="d"
                                android:format24Hour="d"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp" />
                        </LinearLayout>

                        <TextClock
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:format12Hour="MMMM"
                            android:format24Hour="MMMM"
                            android:textColor="#F3E8FF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_card"
                    android:padding="14dp">

                    <EditText
                        android:id="@+id/note"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="Escribe una nota…"
                        android:inputType="textMultiLine|textCapSentences"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/glass_card"
                    android:padding="12dp">

                    <com.purplevoid.launcher.ClockView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/homeSearch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/glass_pill"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:text="🔍   Buscar en el vacío…"
                android:textColor="#E9D5FF"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock0"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_circle"
                        android:padding="14dp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock1"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_circle"
                        android:padding="14dp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock2"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_circle"
                        android:padding="14dp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/dock3"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_circle"
                        android:padding="14dp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- DRAWER -->
        <LinearLayout
            android:id="@+id/drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9120226"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/glass_pill"
                android:hint="🔍   Buscar en el vacío…"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#99E9D5FF" />

            <GridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:horizontalSpacing="4dp"
                android:numColumns="4"
                android:scrollbars="none"
                android:verticalSpacing="18dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
